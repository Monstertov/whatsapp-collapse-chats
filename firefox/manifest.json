{
  "manifest_version": 3,
  "name": "WhatsApp Compact",
  "version": "1.0",
  "description": "Collapsible chat list and a slim nav rail for WhatsApp Web, so it fits a tiled pane.",
  "author": "Monstertov - https://tov.monster/",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "96": "icon.png" },
  "browser_specific_settings": {
    "gecko": { "id": "whatsapp-compact@tov.monster", "strict_min_version": "128.0" }
  }
}
