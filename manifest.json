{
  "manifest_version": 3,
  "name": "WhatsApp Collapse Chats",
  "version": "1.2",
  "description": "Collapsible chat list and a slim nav rail for WhatsApp Web, so it fits narrow windows. Collapsed by default.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
